# Mutinynet LND solver — fill at runtime. Do not commit a filled copy.

SWAP_NETWORK=mutinynet
LN_BACKEND=lnd

# Dedicated solver wallet. Generate with a BIP39 tool. Never log this.
ARK_MNEMONIC=

ARK_SERVER_URL=https://mutinynet.arkade.sh

# Required on Mutinynet. No repository default.
EMULATOR_URL=

LND_SOCKET=
# Exactly one of each pair. Prefer files mounted at runtime, not baked into the image.
LND_CERT_PATH=/run/secrets/lnd_tls.cert
LND_MACAROON_PATH=/run/secrets/lnd_invoice.macaroon
# LND_CERT=
# LND_MACAROON=

LND_ESPLORA_URL=https://mempool.mutinynet.arkade.sh/api
ARK_ESPLORA_URL=https://mempool.mutinynet.arkade.sh/api

# Card advertisement only when command=serve. Relay ingress is a separate command.
RELAY_URL=wss://nostr.arkade.sh

DB_DIR=/data
SWAP_DB_PATH=/data/swaps.sqlite
ARK_DB_PATH=/data/ark.sqlite

MAX_SWAP_SATS=25000
MAX_EXPOSED_SATS=75000
LN_SEND_ENABLED=true
LN_SEND_MAX_SATS=25000
LN_SEND_FEE_BPS=30
LN_RECEIVE_ENABLED=false
LN_RECEIVE_ACCEPT_UNILATERAL_GAP=false
ONCHAIN_SEND_ENABLED=false
ONCHAIN_RECEIVE_ENABLED=false

# Admin console: loopback only. Tunnel in; never publish this port.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8788

HOST=127.0.0.1
PORT=8787
