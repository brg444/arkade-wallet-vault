{
  "name": "arkade",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@arkade-os/sdk": "0.4.65",
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "2.0.0",
    "@scure/btc-signer": "2.0.1",
    "@sentry/react": "^9.15.0",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.5.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "qr": "^0.5.2",
    "qr-scanner": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "scripts": {
    "prepare": "husky install",
    "start": "vite --port 3003 --host localhost",
    "build": "vite build",
    "test": "vitest run",
    "test:ui": "vitest run --ui",
    "test:unit": "vitest run --exclude '**/e2e/**'",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c playwright.vault.config.ts",
    "test:e2e:ui": "playwright test -c playwright.vault.config.ts --ui",
    "test:codegen": "playwright codegen localhost:3003",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^8.0.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "shadcn": "^4.6.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^3.2.4",
    "vitest-fetch-mock": "^0.4.5"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0",
    "pnpm": ">=8"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "@arkade-os/sdk"
    ]
  }
}
