{
  "buildCommand": "bun run build:vault",
  "installCommand": "bun install",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://authorizer-production-72de.up.railway.app/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://authorizer-production-72de.up.railway.app/health"
    },
    {
      "source": "/esplora/:path*",
      "destination": "https://mempool.mutinynet.arkade.sh/api/:path*"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
